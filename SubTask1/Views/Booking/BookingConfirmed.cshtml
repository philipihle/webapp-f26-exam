@model webapp_f26_exam.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isOwner = Model.UserId == currentUserId;
    var participantCount = (Model.Participants?.Count ?? 0) + 1;
    var maxCapacity = Model.Room?.Capacity ?? 0;
    var isParticipant = isOwner || (Model.Participants?.Any(p => p.UserId == currentUserId) ?? false);
    var chatMessages = ViewBag.ChatMessages as IEnumerable<webapp_f26_exam.Models.BookingChat> ?? Enumerable.Empty<webapp_f26_exam.Models.BookingChat>();
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ChatError"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                @TempData["ChatError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Message"] != null)
        {
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-1">Booking Confirmed</h2>
                <p class="text-muted">Your study room details and session settings.</p>
            </div>
        }
        else
        {
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-1">Booking Details</h2>
                <p class="text-muted">Study room details, participants and session discussion.</p>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <span class="text-muted small">Booking #@Model.Id</span>
                @if (Model.JoinFlag)
                {
                    <span class="badge bg-success">Open for others to join</span>
                }
                else
                {
                    <span class="badge bg-secondary">Private session</span>
                }
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-6">
                        <small class="text-muted d-block">Room</small>
                        <span class="fw-semibold">@Model.Room?.Name</span>
                        <small class="text-muted d-block">@Model.Room?.RoomCode</small>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Location</small>
                        <span class="fw-semibold">@Model.Room?.Building</span>
                        <small class="text-muted d-block">Floor @Model.Room?.Floor</small>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Date</small>
                        <span class="fw-semibold">@Model.Start.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Time</small>
                        <span class="fw-semibold">@Model.Start.ToString("HH:mm") – @Model.End.ToString("HH:mm")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Purpose</small>
                        <span class="fw-semibold">@Model.Purpose</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Capacity</small>
                        <span class="fw-semibold">@participantCount / @maxCapacity spots taken</span>
                    </div>
                </div>

                @if (isOwner)
                {
                    <hr class="my-4" />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h6 class="fw-bold mb-0">Session Visibility</h6>
                            <small class="text-muted">Allow other students to join this study session.</small>
                        </div>
                        <form asp-controller="Booking" asp-action="ToggleJoinFlag" asp-route-id="@Model.Id" method="post">
                            @if (Model.JoinFlag)
                            {
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Change to Private</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Allow others to join</button>
                            }
                        </form>
                    </div>
                }

                @if (Model.Participants != null && Model.Participants.Any())
                {
                    <hr class="my-4" />
                    <h6 class="fw-bold mb-3">Participants (@Model.Participants.Count)</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var participant in Model.Participants)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <div>
                                    <span class="fw-medium">@(participant.User?.UserName ?? participant.UserId)</span>
                                    <small class="text-muted d-block">Joined @participant.JoinedAtDateTime.ToString("dd.MM HH:mm")</small>
                                </div>
                                @if (isOwner)
                                {
                                    <form asp-controller="Booking" asp-action="RemoveParticipant" method="post" class="d-inline">
                                        <input type="hidden" name="bookingId" value="@Model.Id" />
                                        <input type="hidden" name="participantUserId" value="@participant.UserId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="card-footer bg-white border-top p-3 d-flex justify-content-between">
                <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary">
                    View My Bookings
                </a>
                <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary">
                    Book Another Room
                </a>
            </div>
        </div>
        @if (isParticipant)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">Session Chat</h5>
                </div>
                <div class="card-body p-4">
                    @if (!chatMessages.Any())
                    {
                        <div class="text-center text-muted py-3">
                            <p class="mb-0">No messages yet. Start the conversation!</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush mb-3">
                            @foreach (var message in chatMessages)
                            {
                                var isMsgAuthor = message.UserId == currentUserId;
                                var canDelete = isMsgAuthor || isOwner || User.IsInRole("Admin");

                                <div class="list-group-item px-0 py-3 border-bottom">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div>
                                            <strong class="text-dark">@(message.User?.UserName ?? message.UserId)</strong>
                                            <small class="text-muted ms-2">@message.SentAt.ToString("dd.MM HH:mm")</small>
                                            @if (message.UpdatedAt != null)
                                            {
                                                <small class="text-muted fst-italic ms-1">(edited)</small>
                                            }
                                        </div>
                                        <div>
                                            @if (isMsgAuthor)
                                            {
                                                <button type="button" class="btn btn-link btn-sm text-secondary text-decoration-none p-0 me-3" 
                                                        data-bs-toggle="collapse" data-bs-target="#edit-msg-@message.Id">
                                                    Edit
                                                </button>
                                            }
                                            @if (canDelete)
                                            {
                                                <form asp-controller="Booking" asp-action="DeleteChatMessage" method="post" class="d-inline">
                                                    <input type="hidden" name="messageId" value="@message.Id" />
                                                    <button type="submit" class="btn btn-link btn-sm text-danger text-decoration-none p-0">Delete</button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                    <p class="mb-0 text-secondary">@message.Message</p>
                                    @if (isMsgAuthor)
                                    {
                                        <div id="edit-msg-@message.Id" class="collapse mt-2">
                                            <form asp-controller="Booking" asp-action="EditChatMessage" method="post">
                                                <input type="hidden" name="messageId" value="@message.Id" />
                                                <div class="input-group input-group-sm">
                                                    <input type="text" name="newMessage" class="form-control" value="@message.Message" maxlength="500" required />
                                                    <button type="submit" class="btn btn-primary">Save</button>
                                                    <button type="button" class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#edit-msg-@message.Id">Cancel</button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <form asp-controller="Booking" asp-action="SendChatMessage" method="post" class="mt-3">
                        <input type="hidden" name="bookingId" value="@Model.Id" />
                        <div class="input-group">
                            <input type="text" name="message" class="form-control" placeholder="Type a message..." maxlength="500" required />
                            <button type="submit" class="btn btn-primary">Send</button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="fw-bold mb-0">Session Chat</h5>
                </div>
                <div class="card-body p-4 text-center text-muted">
                    <p class="mb-0">You must be a participant in this study session to view and send messages.</p>
                </div>
            </div>
        }
    </div>
</div>