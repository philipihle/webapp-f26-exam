@model webapp_f26_exam.Models.Booking
@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="text-center mb-4">
            <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-check-lg fs-2"></i>
            </div>
            <h2 class="fw-bold mb-1">Booking Confirmed</h2>
            <p class="text-muted">Your study room has been booked successfully.</p>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <span class="text-muted small">Booking #@Model.Id</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-6">
                        <small class="text-muted d-block">Room</small>
                        <span class="fw-semibold">@Model.Room?.Name</span>
                        <small class="text-muted d-block">@Model.Room?.RoomCode</small>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Location</small>
                        <span class="fw-semibold">@Model.Room?.Building</span>
                        <small class="text-muted d-block">Floor @Model.Room?.Floor</small>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Date</small>
                        <span class="fw-semibold">@Model.Start.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Time</small>
                        <span class="fw-semibold">@Model.Start.ToString("HH:mm") – @Model.End.ToString("HH:mm")</span>
                    </div>
                    <div class="col-12">
                        <small class="text-muted d-block">Purpose</small>
                        <span class="fw-semibold">@Model.Purpose</span>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-top p-3 d-flex justify-content-between">
                <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary">
                    View My Bookings
                </a>
                <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary">
                    Book Another Room
                </a>
            </div>
        </div>
    </div>
</div>