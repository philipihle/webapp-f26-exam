@using System.Globalization
@model List<webapp_f26_exam.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
    var activeBookings = Model.Where(b => b.End >= DateTime.Now).OrderBy(b => b.Start).ToList();
    var pastBookings = Model.Where(b => b.End < DateTime.Now).OrderByDescending(b => b.Start).ToList();
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">My Bookings</h1>
            <p class="text-secondary mb-0">View and manage your upcoming and previous study room reservations.</p>
        </div>
        <div>
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary px-3 py-2 rounded-pill d-inline-flex align-items-center gap-1 shadow-sm">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span>Book a Room</span>
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
            <span class="material-symbols-outlined align-middle me-1">check_circle</span>
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert">
            <span class="material-symbols-outlined align-middle me-1">error</span>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Active Reservations Section -->
    <div class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h4 class="fw-bold mb-0">Upcoming Sessions</h4>
        </div>

        @if (!activeBookings.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
                <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mx-auto mb-3" style="width: 64px; height: 64px;">
                    <span class="material-symbols-outlined text-secondary" style="font-size: 32px;">event_busy</span>
                </div>
                <h5 class="fw-bold mb-1">No upcoming bookings</h5>
                <p class="text-muted small mb-4">You do not have any active room reservations at the moment.</p>
                <div>
                    <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-primary px-4 py-2 rounded-pill">
                        Find a study room
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var booking in activeBookings)
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white h-100 transition-all">
                            <div class="p-4 d-flex flex-column h-100">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                    <div>
                                        <span class="badge-available small d-inline-flex align-items-center gap-1 mb-2">
                                            <span class="d-inline-block rounded-circle bg-success" style="width: 6px; height: 6px;"></span>
                                            Confirmed
                                        </span>
                                        <h5 class="fw-bold mb-0 text-dark">@(booking.Room?.Name ?? "Study Room")</h5>
                                        <span class="text-muted small">
                                            @booking.Room?.Building &bull; Floor @booking.Room?.Floor &bull; Room @booking.Room?.RoomCode
                                        </span>
                                    </div>
                                    <span class="badge bg-light text-dark border px-3 py-1.5 rounded-pill small">
                                        @booking.Purpose
                                    </span>
                                </div>

                                <div class="bg-light rounded-3 p-3 mb-3">
                                    <div class="d-flex align-items-center gap-2 text-dark fw-semibold mb-1">
                                        <span class="material-symbols-outlined text-[18px] text-primary">calendar_today</span>
                                        @* Using InvariantCulture to make sure weekday and month names are always in English, regardless of the host OS language settings *@
                                        <span>@booking.Start.ToString("dddd, MMMM d, yyyy", CultureInfo.InvariantCulture)</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                        <span class="material-symbols-outlined text-[18px]">schedule</span>
                                        <span>@booking.Start.ToString("HH:mm") &ndash; @booking.End.ToString("HH:mm")</span>
                                        <span class="text-secondary">&bull; (@((booking.End - booking.Start).TotalHours) hrs)</span>
                                    </div>
                                </div>

                                <div class="mt-auto pt-2 d-flex justify-content-between align-items-center border-top">
                                    <div class="text-muted small d-flex align-items-center gap-1">
                                        <span class="material-symbols-outlined text-[16px]">pin_drop</span>
                                        <span>Room @booking.Room?.RoomCode</span>
                                    </div>
                                    <a asp-controller="Booking" asp-action="BookingConfirmed" asp-route-id="@booking.Id"
                                       class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        View details
                                    </a>
                                    <a asp-controller="Booking" asp-action="CancelBooking" asp-route-id="@booking.Id"
                                       class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Past Reservations Section -->
    @if (pastBookings.Any())
    {
        <div>
            <h5 class="fw-bold text-muted mb-3">Previous Bookings (@pastBookings.Count)</h5>
            <div class="list-group rounded-4 shadow-sm border-0 overflow-hidden">
                @foreach (var booking in pastBookings)
                {
                    <div class="list-group-item list-group-item-action border-0 border-bottom p-3 bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                        <div>
                            <span class="fw-semibold text-dark">@(booking.Room?.Name ?? "Study Room")</span>
                            <span class="text-muted small ms-2">(@booking.Room?.RoomCode)</span>
                            <div class="text-muted small">
                                @booking.Start.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) &bull; @booking.Start.ToString("HH:mm") &ndash; @booking.End.ToString("HH:mm") &bull; @booking.Purpose
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-light text-secondary border rounded-pill">Completed</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>