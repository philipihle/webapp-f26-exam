@model List<webapp_f26_exam.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
    var activeBookings = Model.Where(b => b.End >= DateTime.Now).OrderBy(b => b.Start).ToList();
    var pastBookings = Model.Where(b => b.End < DateTime.Now).OrderByDescending(b => b.Start).ToList();
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">My Bookings</h1>
            <p class="text-secondary mb-0">View and manage your upcoming and previous reservations.</p>
        </div>
        <div>
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Book a Room
            </a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Upcoming Sessions Section -->
    <div class="mb-5">
        <h4 class="fw-bold mb-3">Upcoming Sessions</h4>

        @if (!activeBookings.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
                <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mx-auto mb-3" style="width: 56px; height: 56px;">
                    <i class="bi bi-calendar-x text-muted fs-3"></i>
                </div>
                <h5 class="fw-bold mb-1">No upcoming bookings</h5>
                <p class="text-muted small mb-3">You do not have any active room reservations at the moment.</p>
                <div>
                    <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-primary">
                        Find a study room
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var booking in activeBookings)
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="mb-3">
                                    <h5 class="fw-bold text-dark mb-1">@booking.Room?.Name</h5>
                                    <span class="text-muted small">
                                        @booking.Room?.Building &bull; Floor @booking.Room?.Floor &bull; @booking.Room?.RoomCode
                                    </span>
                                </div>

                                <div class="bg-light rounded-3 p-3 mb-3">
                                    <div class="d-flex align-items-center gap-2 text-dark fw-semibold mb-1">
                                        <i class="bi bi-calendar-event text-primary"></i>
                                        <span>@booking.Start.ToString("dd.MM.yyyy")</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                        <i class="bi bi-clock"></i>
                                        <span>@booking.Start.ToString("HH:mm") – @booking.End.ToString("HH:mm")</span>
                                        <span>&bull; @booking.Purpose</span>
                                    </div>
                                </div>

                                <div class="mt-auto pt-2 d-flex justify-content-end gap-2 border-top">
                                    <a asp-controller="Booking" asp-action="BookingConfirmed" asp-route-id="@booking.Id"
                                       class="btn btn-outline-secondary btn-sm">
                                        View Details
                                    </a>
                                    <a asp-controller="Booking" asp-action="CancelBooking" asp-route-id="@booking.Id"
                                       class="btn btn-outline-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to cancel this booking?');">
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Past Reservations Section -->
    @if (pastBookings.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="fw-bold mb-0">Previous Bookings (@pastBookings.Count)</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Room</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in pastBookings)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">@booking.Room?.Name</span>
                                    <small class="text-muted d-block">@booking.Room?.RoomCode &bull; @booking.Room?.Building</small>
                                </td>
                                <td>@booking.Start.ToString("dd.MM.yyyy")</td>
                                <td>@booking.Start.ToString("HH:mm") – @booking.End.ToString("HH:mm")</td>
                                <td><span class="badge bg-light text-dark border">@booking.Purpose</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>