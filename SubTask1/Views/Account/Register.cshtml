@model webapp_f26_exam.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="p-2 rounded-3 bg-dark text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 42px; height: 42px;">
                    <span class="material-symbols-outlined text-[24px]">person_add</span>
                </div>
                <h3 class="fw-bold mb-1">Create Account</h3>
                <p class="text-muted small">Register as a student to book campus study rooms</p>
            </div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label small fw-semibold text-muted"></label>
                    <input asp-for="UserName" class="form-control" placeholder="E.g John Doe" autofocus />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                    <input asp-for="Email" class="form-control" placeholder="youremail@student.no" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold text-muted"></label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-muted"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2.5 mb-3">Register Account</button>

                <div class="text-center small text-muted">
                    Already have an account? <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-semibold text-primary">Sign in here</a>
                </div>
            </form>
        </div>
    </div>
</div>