@{
    ViewData["Title"] = "Welcome";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5" style="min-height: 72vh;">
    <div class="mb-3 d-inline-flex align-items-center justify-content-center rounded-4 shadow-sm" style="width: 76px; height: 76px; background-color: #0f172a;">
        <i class="bi bi-door-open text-white" style="font-size: 2.25rem;"></i>
    </div>

    <h1 class="display-6 fw-bold text-dark mb-1">BookingPortal</h1>
    <p class="text-muted small mb-4">Campus study rooms &amp; workspace reservations</p>

    @if (!isAuthenticated)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-5 bg-white text-center" style="max-width: 400px; width: 100%;">
            <p class="text-secondary small mb-4">
                Sign in or register to get started.
            </p>

            <div class="d-grid gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign in</span>
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary btn-lg fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-person-plus"></i>
                    <span>Register</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-5 bg-white text-center" style="max-width: 400px; width: 100%;">
            <p class="text-muted small mb-4">
                Welcome back, <strong>@(User.Identity?.Name ?? "User")</strong>!
            </p>
            <div class="d-grid gap-2">
                <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary btn-lg fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-door-open"></i>
                    <span>Find a room</span>
                </a>
                <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary btn-lg fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-calendar-event"></i>
                    <span>My bookings</span>
                </a>
            </div>
        </div>
    }
</div>
