@{
    ViewData["Title"] = "Campus Study Rooms";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="py-3">
    <section class="text-center py-5 px-3">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <h1 class="display-5 fw-bold text-dark mb-3">
                    Campus Study Rooms &amp; Workspaces
                </h1>
                <p class="fs-5 text-muted mb-4">
                    Find and book quiet study pods, group rooms, and meeting spaces across campus buildings.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary btn-lg px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-door-open"></i>
                        <span>Find a Room</span>
                    </a>
                    @if (isAuthenticated)
                    {
                        <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary btn-lg px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                            <i class="bi bi-calendar-event"></i>
                            <span>My Bookings</span>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Sign In</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Room Types Overview -->
    <section class="py-5 border-top">
        <div class="text-center mb-5">
            <h2 class="h3 fw-bold text-dark mb-1">Our Study Spaces</h2>
            <p class="text-muted small">Choose the room type that best matches your study needs.</p>
        </div>

        <div class="row g-4">
            <!-- Quiet Rooms -->
            <div class="col-md-4">
                <div class="card border shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="p-3 rounded-3 bg-light text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                            <i class="bi bi-volume-mute fs-4"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Quiet Study Rooms</h5>
                        <div class="small text-muted mb-3">1–2 persons &bull; Quiet zone</div>
                        <p class="text-secondary small mb-3">
                            Individual and dual study spaces suitable for quiet reading, concentration, and exam preparation.
                        </p>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            <span class="badge bg-light text-dark border small fw-normal">Power sockets</span>
                            <span class="badge bg-light text-dark border small fw-normal">Desk space</span>
                            <span class="badge bg-light text-dark border small fw-normal">Quiet area</span>
                        </div>
                    </div>
                    <div class="pt-3 border-top">
                        <a asp-controller="Rooms" asp-action="Index" asp-route-capacity="1-2" class="text-decoration-none fw-semibold small text-primary d-inline-flex align-items-center gap-1">
                            <span>Browse quiet rooms</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Group Study Rooms -->
            <div class="col-md-4">
                <div class="card border shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="p-3 rounded-3 bg-light text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Group Study Rooms</h5>
                        <div class="small text-muted mb-3">3–6 persons &bull; Team collaboration</div>
                        <p class="text-secondary small mb-3">
                            Enclosed study rooms designed for group assignments, seminar prep, and project teamwork.
                        </p>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            <span class="badge bg-light text-dark border small fw-normal">Whiteboards</span>
                            <span class="badge bg-light text-dark border small fw-normal">Group table</span>
                            <span class="badge bg-light text-dark border small fw-normal">Power outlets</span>
                        </div>
                    </div>
                    <div class="pt-3 border-top">
                        <a asp-controller="Rooms" asp-action="Index" asp-route-capacity="3-6" class="text-decoration-none fw-semibold small text-primary d-inline-flex align-items-center gap-1">
                            <span>Browse group rooms</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Presentation / Large Rooms -->
            <div class="col-md-4">
                <div class="card border shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="p-3 rounded-3 bg-light text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                            <i class="bi bi-display fs-4"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Large Rooms &amp; Labs</h5>
                        <div class="small text-muted mb-3">7+ persons &bull; Presentation spaces</div>
                        <p class="text-secondary small mb-3">
                            Larger rooms equipped with wall displays and presentation screens for practice sessions and group presentations.
                        </p>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            <span class="badge bg-light text-dark border small fw-normal">Display screen</span>
                            <span class="badge bg-light text-dark border small fw-normal">HDMI / AV</span>
                            <span class="badge bg-light text-dark border small fw-normal">Whiteboard</span>
                        </div>
                    </div>
                    <div class="pt-3 border-top">
                        <a asp-controller="Rooms" asp-action="Index" asp-route-capacity="7+" class="text-decoration-none fw-semibold small text-primary d-inline-flex align-items-center gap-1">
                            <span>Browse large rooms</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Practical Information -->
    <section class="py-5 border-top">
        <div class="text-center mb-5">
            <h2 class="h3 fw-bold text-dark mb-1">Practical Information</h2>
            <p class="text-muted small">Helpful details about reserving and using campus rooms.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card border shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="text-primary mb-3">
                        <i class="bi bi-calendar-check fs-3"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Easy Booking</h6>
                    <p class="text-muted small mb-0">
                        Select a room and pick your desired time slot. You receive an instant confirmation.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="text-primary mb-3">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Booking Duration</h6>
                    <p class="text-muted small mb-0">
                        Book time slots to fit your study schedule, from one hour up to several hours.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="text-primary mb-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Campus Buildings</h6>
                    <p class="text-muted small mb-0">
                        Rooms are located across campus buildings with room codes indicating building and floor.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card border shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="text-primary mb-3">
                        <i class="bi bi-wifi fs-3"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Wi-Fi &amp; Amenities</h6>
                    <p class="text-muted small mb-0">
                        All study spaces provide wireless network access, power outlets, and whiteboard facilities.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section class="py-4">
        <div class="card border-0 bg-light rounded-4 p-4 p-md-5 text-center">
            <h3 class="fw-bold text-dark mb-2">Ready to reserve a space?</h3>
            <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">
                Check available rooms and book your study space in just a few clicks.
            </p>
            <div>
                <a asp-controller="Rooms" asp-action="Index" class="btn btn-primary px-4 py-2 shadow-sm fw-semibold d-inline-flex align-items-center gap-2">
                    <i class="bi bi-search"></i>
                    <span>Go to Room Finder</span>
                </a>
            </div>
        </div>
    </section>
</div>
