@model webapp_f26_exam.ViewModels.StatsViewModel
@{
    ViewData["Title"] = "Statistics";
}

<div class="py-4">
    <div class="row align-items-center justify-content-between mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1">Statistics</h2>
            <p class="text-muted mb-0">Overview of users, study rooms, and bookings.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                Back to Portal
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4 pb-2 border-bottom">
        <div class="col-sm-6 col-lg-3">
            <div class="text-muted small fw-semibold mb-1">Total Users</div>
            <div class="fs-2 fw-bold text-dark mb-0">@Model.TotalUsers</div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="text-muted small fw-semibold mb-1">Study Rooms</div>
            <div class="fs-2 fw-bold text-dark mb-0">@Model.TotalRooms</div>
            <small class="text-muted">@Model.AvailableRooms available right now</small>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="text-muted small fw-semibold mb-1">Active Bookings</div>
            <div class="fs-2 fw-bold text-dark mb-0">@Model.ActiveBookings</div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="text-muted small fw-semibold mb-1">Total Bookings</div>
            <div class="fs-2 fw-bold text-dark mb-0">@Model.TotalBookings</div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold mb-0">Most Booked Rooms</h5>
                </div>
                <div class="card-body p-4 pt-2">
                    @if (Model.TopRooms != null && Model.TopRooms.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Room</th>
                                        <th class="text-end">Bookings</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var room in Model.TopRooms)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold text-dark">@room.RoomName</span>
                                            <span class="text-muted small d-block">@room.RoomCode</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="text-dark fw-semibold">@room.BookingCount</span>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0">No booking data yet.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold mb-0">Recent Bookings</h5>
                </div>
                <div class="card-body p-4 pt-2">
                    @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Room</th>
                                        <th>User</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var booking in Model.RecentBookings)
                                {
                                    var isUpcoming = booking.End >= DateTime.Now;
                                    <tr>
                                        <td>
                                            <span class="fw-semibold text-dark">@(booking.Room?.Name ?? "Room " + booking.RoomId)</span>
                                            <small class="text-muted d-block">@booking.Room?.RoomCode</small>
                                        </td>
                                        <td>
                                            <span class="text-dark small">@(booking.User?.UserName ?? booking.UserId)</span>
                                        </td>
                                        <td>
                                            <span class="small d-block text-dark">@booking.Start.ToString("dd.MM.yyyy")</span>
                                            <small class="text-muted">@booking.Start.ToString("HH:mm") &ndash; @booking.End.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            @if (isUpcoming)
                                            {
                                                <span class="text-success fw-semibold small">Active</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Completed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0">No recent bookings found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
