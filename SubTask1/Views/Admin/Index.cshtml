@{
    ViewData["Title"] = "Admin Portal";
}

<div class="py-4">
    <div class="mb-4">
        <h1 class="display-6 fw-bold mb-1">Admin Portal</h1>
        <p class="text-muted mb-0">Manage users, access roles, and view booking statistics.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        <!-- Users -->
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-people fs-4 text-primary me-2"></i>
                        <h5 class="fw-bold mb-0">Users</h5>
                    </div>
                    <p class="text-muted small mb-4">
                        View registered users, edit contact details, and remove user accounts.
                    </p>
                </div>
                <div>
                    <a asp-action="Users" class="btn btn-outline-primary btn-sm w-100">
                        Manage Users
                    </a>
                </div>
            </div>
        </div>

        <!-- Roles -->
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-shield-lock fs-4 text-primary me-2"></i>
                        <h5 class="fw-bold mb-0">Roles</h5>
                    </div>
                    <p class="text-muted small mb-4">
                        Assign administrator privileges and promote or demote users.
                    </p>
                </div>
                <div>
                    <a asp-action="Roles" class="btn btn-outline-primary btn-sm w-100">
                        Manage Roles
                    </a>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-bar-chart-line fs-4 text-primary me-2"></i>
                        <h5 class="fw-bold mb-0">Statistics</h5>
                    </div>
                    <p class="text-muted small mb-4">
                        Review room inventory, popular rooms, and recent booking activity.
                    </p>
                </div>
                <div>
                    <a asp-action="Stats" class="btn btn-outline-primary btn-sm w-100">
                        View Statistics
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
