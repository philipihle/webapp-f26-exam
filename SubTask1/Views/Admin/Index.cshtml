@{
    ViewData["Title"] = "Admin Portal";
}

<div class="py-4">
    <div class="mb-4">
        <h1 class="h2 fw-bold text-dark mb-1">Admin Portal</h1>
        <p class="text-secondary mb-0">Manage users, access roles, and view booking statistics.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-dark mb-2">Users</h5>
                    <p class="text-muted small mb-4">
                        View registered users, edit contact details, and remove user accounts.
                    </p>
                </div>
                <div>
                    <a asp-action="Users" class="btn btn-outline-secondary btn-sm">
                        Manage users &rarr;
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-dark mb-2">Roles</h5>
                    <p class="text-muted small mb-4">
                        Assign administrator privileges and promote or demote users.
                    </p>
                </div>
                <div>
                    <a asp-action="Roles" class="btn btn-outline-secondary btn-sm">
                        Manage roles &rarr;
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-dark mb-2">Statistics</h5>
                    <p class="text-muted small mb-4">
                        Review room inventory, popular rooms, and recent booking activity.
                    </p>
                </div>
                <div>
                    <a asp-action="Stats" class="btn btn-outline-secondary btn-sm">
                        View statistics &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
