@model webapp_f26_exam.ViewModels.RolesViewModel
@{
    ViewData["Title"] = "Manage Roles";
    var currentUserName = User.Identity?.Name;
}

<div class="container py-4">
    <div class="row align-items-center justify-content-between mb-4">
        <div class="col-md-8">
            <h1 class="display-6 fw-bold">Role Management</h1>
            <p class="text-muted mb-0">Manage roles and permissions. Users default to <strong>Student</strong>, and can be promoted to <strong>Admin</strong>.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 0-1H1.5A.5.5 0 0 0 1 8M15 8a.5.5 0 0 1-.5.5H2.707l3.147 3.146a.5.5 0 0 1-.708.708l-4-4a.5.5 0 0 1 0-.708l4-4a.5.5 0 0 1 .708.708L2.707 7.5H14.5A.5.5 0 0 1 15 8"/>
                </svg>
                Back to Portal
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-title text-muted mb-0">System Roles</h6>
                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill">2 Available</span>
                    </div>
                    <div class="display-6 fw-bold text-info">Admin / Student</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-title text-muted mb-0">Admin Users</h6>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">@(Model?.AdminCount ?? 0)</span>
                    </div>
                    <div class="display-5 fw-bold text-primary">@(Model?.AdminCount ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-title text-muted mb-0">Student Users</h6>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">@(Model?.StudentCount ?? 0)</span>
                    </div>
                    <div class="display-5 fw-bold text-success">@(Model?.StudentCount ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="card-title text-muted mb-0">Total Users</h6>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">@(Model?.TotalUsers ?? 0)</span>
                    </div>
                    <div class="display-5 fw-bold text-secondary">@(Model?.TotalUsers ?? 0)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Role Assignment Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-1">User Role Assignment</h5>
                <p class="text-muted small mb-0">Change user access by assigning either Student or Admin.</p>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th scope="col">User</th>
                        <th scope="col">Current Role</th>
                        <th scope="col" class="text-end">Change Role</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model?.Users != null && Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            var isCurrentUser = user.Email.Equals(currentUserName, StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td>
                                    <div class="fw-bold">@user.Email</div>
                                    @if (isCurrentUser)
                                    {
                                        <span class="badge bg-light text-dark border">You</span>
                                    }
                                </td>
                                <td>
                                    @if (user.CurrentRole == "Admin")
                                    {
                                        <span class="badge bg-primary px-3 py-2 rounded-pill">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">
                                            Student
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="SetUserRole" method="post" class="d-inline-flex gap-2 justify-content-end align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.UserId"/>
                                        @if (user.CurrentRole == "Student")
                                        {
                                            <input type="hidden" name="newRole" value="Admin"/>
                                            <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                Promote to Admin
                                            </button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="newRole" value="Student"/>
                                            <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                                    @(isCurrentUser ? "disabled" : "")
                                                    title="@(isCurrentUser ? "You cannot demote yourself" : "Change to Student")"
                                                    onclick="return confirm('Are you sure you want to change @user.Email to Student?');">
                                                Change to Student
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                No registered users found.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>