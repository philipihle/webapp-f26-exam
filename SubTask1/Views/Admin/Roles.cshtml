@model webapp_f26_exam.ViewModels.RolesViewModel
@{
    ViewData["Title"] = "Manage Roles";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="py-4">
    <div class="row align-items-center justify-content-between mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1">Role Management</h2>
            <p class="text-muted mb-0">Manage roles and permissions for registered campus users.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                Back to Portal
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">User</th>
                            <th scope="col">Current Role</th>
                            <th scope="col" class="text-end">Change Role</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            var isCurrentUser = user.UserId == currentUserId;
                            <tr>
                                <td>
                                    <span class="fw-semibold text-dark">@user.Name</span>
                                    @if (isCurrentUser)
                                    {
                                        <small class="text-muted ms-1">(You)</small>
                                    }
                                    <small class="text-muted d-block">@user.Email</small>
                                </td>
                                <td>
                                    @if (user.CurrentRole == "Admin")
                                    {
                                        <span class="fw-semibold text-dark">
                                            Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Student
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="SetUserRole" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.UserId"/>
                                        @if (user.CurrentRole == "Student")
                                        {
                                            <input type="hidden" name="newRole" value="Admin"/>
                                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                                Promote to Admin
                                            </button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="newRole" value="Student"/>
                                            <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                    @(isCurrentUser ? "disabled" : "")
                                                    title="@(isCurrentUser ? "You cannot demote yourself" : "Change to Student")"
                                                    onclick="return confirm('Are you sure you want to change @user.Email to Student?');">
                                                Change to Student
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                No registered users found.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>