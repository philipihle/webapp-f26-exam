@model webapp_f26_exam.ViewModels.RoomFormViewModel
@{
    ViewData["Title"] = "Edit Room";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h3 class="fw-bold mb-1">Edit Room</h3>
            <p class="text-muted small mb-3">Room code: <strong>@Model.RoomCode</strong></p>

            <form asp-action="EditRoom" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RoomCode" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label small fw-semibold text-muted"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Building" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Building" class="form-control" />
                        <span asp-validation-for="Building" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Floor" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Floor" class="form-control" />
                        <span asp-validation-for="Floor" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Capacity" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Capacity" min="1" class="form-control" />
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="RoomType" class="form-label small fw-semibold text-muted">Room Type</label>
                    <select asp-for="RoomType" class="form-select">
                        <option value="Pod">Pod</option>
                        <option value="Group Room">Group Room</option>
                        <option value="Meeting Room">Meeting Room</option>
                        <option value="Auditorium">Auditorium</option>
                    </select>
                    <span asp-validation-for="RoomType" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted d-block">Amenities</label>
                    <div class="d-flex flex-wrap gap-3">
                        @for (int i = 0; i < Model.AvailableAmenities.Count; i++)
                        {
                            var amenity = Model.AvailableAmenities[i];
                            <div class="form-check form-check-inline m-0">
                                <input class="form-check-input" type="checkbox" name="Amenities" value="@amenity"
                                       id="amenity_@i" checked="@Model.Amenities.Contains(amenity)" />
                                <label class="form-check-label small" for="amenity_@i">@amenity</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-semibold text-muted"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label small">Active (visible for booking)</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Rooms" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
