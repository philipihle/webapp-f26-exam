@model webapp_f26_exam.ViewModels.RoomsListViewModel
@{
    ViewData["Title"] = "Manage Rooms";
}

<div class="py-4">
    <div class="row align-items-center justify-content-between mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1">Room Management</h2>
            <p class="text-muted mb-0">Add, edit, or remove study rooms.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0 d-flex justify-content-md-end gap-2">
            <a asp-action="CreateRoom" class="btn btn-primary btn-sm">Add Room</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Portal</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form asp-action="Rooms" method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Building</label>
                    <select name="building" class="form-select form-select-sm bg-light border-0">
                        <option value="All" selected="@(Model.SelectedBuilding == "All")">All Buildings</option>
                        @foreach (var building in Model.AvailableBuildings)
                        {
                            <option value="@building" selected="@(Model.SelectedBuilding == building)">@building</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Room Type</label>
                    <select name="roomType" class="form-select form-select-sm bg-light border-0">
                        <option value="All" selected="@(Model.SelectedRoomType == "All")">All Types</option>
                        @foreach (var roomType in Model.AvailableRoomTypes)
                        {
                            <option value="@roomType" selected="@(Model.SelectedRoomType == roomType)">@roomType</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                    <select name="isActive" class="form-select form-select-sm bg-light border-0">
                        <option value="" selected="@(Model.SelectedIsActive == null)">All</option>
                        <option value="true" selected="@(Model.SelectedIsActive == true)">Active</option>
                        <option value="false" selected="@(Model.SelectedIsActive == false)">Inactive</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
                    <a asp-action="Rooms" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Room</th>
                            <th>Location</th>
                            <th>Floor</th>
                            <th>Type</th>
                            <th>Capacity</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rooms.Any())
                        {
                            @foreach (var room in Model.Rooms)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold text-dark">@room.Name</span>
                                        <small class="text-muted d-block">@room.RoomCode</small>
                                    </td>
                                    <td>@room.Building</td>
                                    <td>@room.Floor</td>
                                    <td>@(string.IsNullOrEmpty(room.RoomType) ? "-" : room.RoomType)</td>
                                    <td>@room.Capacity</td>
                                    <td>
                                        <span class="badge @(room.IsActive ? "bg-success" : "bg-secondary")">
                                            @(room.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="EditRoom" asp-route-id="@room.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                        <form asp-action="DeleteRoom" asp-route-id="@room.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete room @room.RoomCode?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">No rooms found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

