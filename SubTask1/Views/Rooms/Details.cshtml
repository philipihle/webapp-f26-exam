@model webapp_f26_exam.ViewModels.RoomItemViewModel
@{
    ViewData["Title"] = Model.Name;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="py-4">
    <!-- Back Navigation -->
    <div class="mb-4">
        <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill d-inline-flex align-items-center gap-1">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Back to all rooms</span>
        </a>
    </div>

    <div class="row g-4">
        <!-- Left: Image & Overview -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
                <div class="position-relative" style="height: 360px; background-color: #f1f5f9;">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100 object-fit-cover" onerror="this.onerror=null; this.src='https://placehold.co/800x500/f1f5f9/475569?text=' + encodeURIComponent('@Model.RoomCode');" />
                    @if (Model.IsAvailableNow)
                    {
                        <span class="badge-available position-absolute top-0 start-0 m-3 shadow-sm d-inline-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle bg-success" style="width: 6px; height: 6px;"></span>
                            @Model.StatusText
                        </span>
                    }
                    else
                    {
                        <span class="badge-occupied position-absolute top-0 start-0 m-3 shadow-sm d-inline-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle bg-danger" style="width: 6px; height: 6px;"></span>
                            @Model.StatusText
                        </span>
                    }
                </div>
                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="display-6 fw-bold mb-0">@Model.Name</h2>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                            <span class="material-symbols-outlined text-[16px] me-1">person</span>
                            @Model.Capacity people max
                        </span>
                    </div>
                    <p class="text-muted mb-4 fs-5">@Model.Building &bull; Floor @Model.Floor &bull; Room @Model.RoomCode</p>
                    <p class="text-secondary mb-4">@Model.Description</p>

                    <h5 class="fw-bold mb-3">Room Amenities &amp; Facilities</h5>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var amenity in Model.Amenities)
                        {
                            <span class="badge bg-light text-dark border px-3 py-2 rounded-3 fs-6 fw-normal d-inline-flex align-items-center gap-1">
                                <span class="material-symbols-outlined text-[16px] text-success">check</span>
                                @amenity
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Reservation Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
                <h4 class="fw-bold mb-1">Reserve this Room</h4>
                <p class="text-muted small mb-4">Select your study slot. Reservations can be made up to 7 days in advance.</p>

                <div class="p-3 bg-light rounded-3 mb-3">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Current Status:</span>
                        <strong class="@(Model.IsAvailableNow ? "text-success" : "text-danger")">@Model.StatusText</strong>
                    </div>
                    <div class="d-flex justify-content-between text-muted small">
                        <span>Availability detail:</span>
                        <span>@Model.AvailabilityDetail</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Select Date</label>
                    <input type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold text-muted">Duration Interval</label>
                    <select class="form-select">
                        <option>1 hour (Quick session)</option>
                        <option selected>2 hours (Standard study slot)</option>
                        <option>3 hours (Extended team project)</option>
                        <option>4 hours (Maximum quota limit)</option>
                    </select>
                </div>

                @if (isAuthenticated)
                {
                    <button class="btn btn-primary w-100 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-1"
                            onclick="alert('Your reservation for @Model.Name (@Model.RoomCode) has been submitted!');">
                        <span class="material-symbols-outlined text-[18px]">event_available</span>
                        <span>Confirm Reservation</span>
                    </button>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 py-2.5 fw-semibold d-inline-flex align-items-center justify-content-center gap-1">
                        <span>Sign in to Reserve</span>
                    </a>
                }

                <div class="text-center mt-3 small text-muted">
                    <span class="material-symbols-outlined text-[16px] align-middle me-1">info</span>
                    Check in with your card within 15 min of arrival.
                </div>
            </div>
        </div>
    </div>
</div>
